import std;
import llamacpp;

struct Backend {
    Backend() { llama_backend_init(); }
    ~Backend() { llama_backend_free(); }
};

int main(int argc, char** argv) {
    // Destroy every model/context before releasing the backend.
    const Backend backend;
    std::println("llama.cpp CPU ready: {}", llama_print_system_info());
    if (argc < 2) {
        std::println("Pass a local GGUF path to decode and sample: mcpp run -- model.gguf");
        return 0;
    }
    auto params = llama_model_default_params();
    params.n_gpu_layers = 0;
    const auto model = std::unique_ptr<llama_model, decltype(&llama_model_free)>(
        llama_model_load_from_file(argv[1], params), llama_model_free);
    if (!model) return 1;
    auto context_params = llama_context_default_params();
    context_params.n_ctx = 64;
    context_params.n_threads = 2;
    const auto context = std::unique_ptr<llama_context, decltype(&llama_free)>(
        llama_init_from_model(model.get(), context_params), llama_free);
    if (!context) return 2;
    if (llama_vocab_n_tokens(llama_model_get_vocab(model.get())) < 4) return 3;
    llama_token tokens[]{1, 2, 3};
    if (llama_decode(context.get(), llama_batch_get_one(tokens, 3))) return 4;
    const auto sampler = std::unique_ptr<llama_sampler, decltype(&llama_sampler_free)>(
        llama_sampler_init_greedy(), llama_sampler_free);
    const auto sampled = llama_sampler_sample(sampler.get(), context.get(), -1);
    if (sampled < 0 || sampled >= llama_vocab_n_tokens(llama_model_get_vocab(model.get()))) return 5;
    std::println("CPU decode passed; sampled token {}", sampled);
}
